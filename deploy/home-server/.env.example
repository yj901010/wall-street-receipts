# Copy to deploy/home-server/.env.production only on the future home server.
# This file contains no secret values. Never paste the real values into chat.
WSR_DOMAIN=stocks.example.com
WSR_ACME_EMAIL=operator@example.com
WSR_IMAGE_TAG=replace-with-git-sha
WSR_POSTGRES_PASSWORD_FILE=/etc/wall-street-receipts/secrets/postgres_password

# Human-verified ingress facts. `publish` preflight rejects `unknown`.
WSR_INGRESS_MODE=unknown
WSR_PUBLIC_IP_POLICY=unknown
WSR_PUBLIC_IPV4=unknown
WSR_PUBLIC_IPV6=unknown

# Used only by the loopback rehearsal profile.
WSR_REHEARSAL_PORT=18080

# CPU and memory envelopes are fixed in compose.yaml and are not env overrides.
