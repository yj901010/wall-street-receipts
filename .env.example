# Safe local defaults only. Never add production credentials to this file.
APP_ENV=local
DATA_MODE=DEMO

# PostgreSQL (the only P0 Compose dependency)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wsr
POSTGRES_USER=wsr
POSTGRES_PASSWORD=wsr

# Application endpoints
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DATA_MODE=DEMO

# Call ledger/detail source. `api` keeps the list and the complete
# detail/context/revision audit on private server-side Spring transports; use
# `fixture` only for explicit offline development and tests. API failures never
# fall back to fixture data.
CALL_AUDIT_PROVIDER=api

# Deterministic local providers
FIXTURE_VERSION=v1
MARKET_PROVIDER=fixture
ANALYST_PROVIDER=fixture
MACRO_PROVIDER=fixture
MEDIA_PROVIDER=fixture
FIXTURE_TICK_INTERVAL_MS=1000
MARKET_STALE_AFTER_SECONDS=15

# P5 public-data providers remain server-only and disabled by default.
# SEC EDGAR does not use an API key; it requires a declared contact email in
# the User-Agent when the provider is explicitly enabled.
SEC_PROVIDER_ENABLED=false
SEC_BASE_URL=https://data.sec.gov
SEC_CONTACT_EMAIL=

# ADR-043 local-only single-operator HTTP boundary. This does not enable SEC
# network access. Keep disabled outside an isolated local API process; when
# enabled, provide only the lowercase SHA-256 digest of the canonical standard
# Base64 encoding of exactly 32 random bytes.
# Never put the raw Bearer token in this file.
OPERATOR_API_ENABLED=false
OPERATOR_API_TOKEN_SHA256=

# Later-phase infrastructure remains disabled in P0.
REDIS_ENABLED=false
KAFKA_ENABLED=false
CLICKHOUSE_ENABLED=false
OPENSEARCH_ENABLED=false
