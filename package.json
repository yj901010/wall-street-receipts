{
  "name": "wall-street-receipts",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @wall-street-receipts/web dev",
    "build": "pnpm --filter @wall-street-receipts/web build",
    "lint": "pnpm --filter @wall-street-receipts/web lint",
    "test": "pnpm --filter @wall-street-receipts/web test",
    "test:e2e": "pnpm --filter @wall-street-receipts/web test:e2e",
    "check": "pnpm lint && pnpm test && pnpm build"
  }
}
