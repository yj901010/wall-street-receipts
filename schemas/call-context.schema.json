{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wall-street-receipts:schema:call-context:1.0.0",
  "title": "Canonical Call Context Response",
  "description": "Closed additive read response for nullable macro and scheduled-event context. Market snapshot remains in the unchanged analyst-call detail response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "macroSnapshot",
    "eventContext"
  ],
  "properties": {
    "macroSnapshot": {
      "oneOf": [
        {
          "$ref": "urn:wall-street-receipts:schema:macro-snapshot:1.0.0"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventContext": {
      "oneOf": [
        {
          "$ref": "urn:wall-street-receipts:schema:event-context:1.0.0"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
